# list methods with blocks, the topic of a bare block
my @a = (3,1,2,3);
say @a.map({ $_ * 2 }).join(",");         #=> 6,2,4,6
say @a.grep({ $_ > 1 }).elems;            #=> 3
say @a.sum;                               #=> 9
say @a.max;                               #=> 3
say @a.min;                               #=> 1
say @a.unique.join("-");                  #=> 3-1-2
say (1,(2,3)).flat.elems;                 #=> 3
say (1,2,3).map(-> $x { $x + 1 }).join(" ");   #=> 2 3 4
my $f = { $_ * 2 };
say $f(4);                                #=> 8
say @a[1..2].join(",");                   #=> 1,2
say @a[0,2].join(",");                    #=> 3,2
say @a[*-1];                              #=> 3
my %h = (a => 1, b => 2, c => 3);
say %h<a b>.join(",");                    #=> 1,2
say %h{"a","c"}.join(",");                #=> 1,3
say @a.grep(* > 1).join(",");             #=> 3,2,3
say @a.map(* * 2).join(",");              #=> 6,2,4,6
say @a.map(*.Str).join("-");              #=> 3-1-2-3
say "7".Int + 1;                          #=> 8
say 5.Str;                                #=> 5
# @a = EXPR wraps a non-list RHS in a one-element list (checked against raku)
my @one = (1);
say @one.elems ~ " " ~ @one[0];           #=> 1 1
my @scalar = 42;
say @scalar.elems ~ " " ~ @scalar[0];     #=> 1 42
my @str = "x";
say @str.elems ~ " " ~ @str[0];           #=> 1 x
my @re = 42;
@re = 99;
say @re.elems ~ " " ~ @re[0];             #=> 1 99
my @copy = @scalar;
say @copy.elems ~ " " ~ @copy[0];         #=> 1 42
# grep :k/:kv/:p/:v flags, function and method form (checked against raku)
my @b = (3,1,2,3);
say grep({ $_ > 1 }, @b, :k).join(",");   #=> 0,2,3
say @b.grep({ $_ > 1 }, :k).join(",");    #=> 0,2,3
say grep({ $_ > 1 }, @b, :kv).join(",");  #=> 0,3,2,2,3,3
say @b.grep({ $_ > 1 }, :kv).join(",");   #=> 0,3,2,2,3,3
say grep({ $_ > 1 }, @b, :v).join(",");   #=> 3,2,3
say grep({ $_ > 1 }, @b).join(",");       #=> 3,2,3
say grep({ $_ > 1 }, @b, :p).elems;       #=> 3
say @b.grep({ $_ > 1 }, :p).elems;        #=> 3
