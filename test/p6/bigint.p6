# bigint literals beyond int64
say 9223372036854775807;          #=> 9223372036854775807
say 9223372036854775807 + 1;      #=> 9223372036854775808
say 123456789012345678901234567890; #=> 123456789012345678901234567890
say 18446744073709551615;         #=> 18446744073709551615
say 0xFFFFFFFFFFFFFFFF;           #=> 18446744073709551615
say :10<987654321098765432109876543210>; #=> 987654321098765432109876543210
my $b = 100000000000000000000;
say $b > 99;                      #=> True
say $b;                           #=> 100000000000000000000
