# requires a TCP daemon on localhost port 80
# regression: collections between Aio_tcp creation, connect and the callback
# must neither move the handle/request nor the callback closure, and must
# keep the interned names of loaded methods (potion_bind "Aio_tcp").
load "aio"
tcp = Aio_tcp
connected = 0
connect_cb = (req,status):
  connected++
  "connected" print.
tcp connect(Aio_connect, "127.0.0.1", 80, connect_cb)
i = 0
while (i < 300000):
  junk = "x" + (i string)
  i = i + 1.
tcp run
if (connected == 0): "not connected" print.
""
#=> connected
