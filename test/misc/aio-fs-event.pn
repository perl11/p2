# requires a working libuv (aio does not load on some BSDs)
# regression: the Aio_fs_event callback finds its handle by pointer arithmetic from the uv struct;
# a wrong self pointer crashed in the callback. A timer rewrites the file until the event arrives
# (at most 30 times, so that a missed event cannot hang the test).
load "aio"
# the watched file exists first: kqueue (BSD) reports changes of a file, not of a directory entry
f = File("aio-fs-event.tmp", "w")
f write("x")
f close
w = Aio_fs_event
t = Aio_timer
seen = 0
ticks = 0
cb = (name, events, status):
  seen++
  self stop
  t stop
  "event" print.
tick = (status):
  ticks++
  f = File("aio-fs-event.tmp", "w")
  f write("x")
  f close
  if (ticks > 30):
    w stop
    t stop..
w start(cb, "aio-fs-event.tmp", 0)
t start(tick, 100, 100)
w run
if (seen == 0): "no event" print.
""
#=> event
